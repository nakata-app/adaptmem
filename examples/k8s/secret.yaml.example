## Secret template — copy to secret.yaml, fill in real values, NEVER commit secret.yaml.
##
## Generate base64 values:
##   echo -n "your-api-key-here" | base64
##
## Or use kubectl:
##   kubectl create secret generic adaptmem-secret \
##       --from-literal=ADAPTMEM_API_KEY=your-api-key-here \
##       --from-literal=OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=yourkey \
##       --dry-run=client -o yaml > secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: adaptmem-secret
  labels:
    app: adaptmem
type: Opaque
data:
  # base64-encoded; replace with your real key.
  # echo -n "change-me-to-a-real-secret" | base64
  ADAPTMEM_API_KEY: Y2hhbmdlLW1lLXRvLWEtcmVhbC1zZWNyZXQ=

  # Optional: Honeycomb / Datadog / observability backend headers.
  # Format: "x-honeycomb-team=KEY,x-other-header=VAL"
  # OTEL_EXPORTER_OTLP_HEADERS: <base64>
